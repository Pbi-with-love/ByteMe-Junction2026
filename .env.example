# Copy to .env and fill in real values. .env is gitignored; never commit secrets.

# Valio mock API (base URL + key come from the resource portal docs)
VALIO_API_BASE_URL=https://junction26.valioaimo.fi
VALIO_API_KEY=
# Customer id used for the sample /api/price and /api/availability calls (prices are customer-specific)
VALIO_CUSTOMER_ID=123

# Anthropic API (LLM: parse requests, write explanations)
ANTHROPIC_API_KEY=

# Private key used by the gateway to sign mandates and quotes
QUOTE_SIGNING_KEY=
APPROVAL_TIMEOUT_SECONDS=20
ANTHROPIC_MODEL=claude-haiku-5-5
# Test/demo only: delay the template explanation by this many milliseconds.
EXPLAIN_DELAY_MS=0
